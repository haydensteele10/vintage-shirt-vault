REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# eBay credentials — set as Supabase Edge Function secrets, NOT in .env
# supabase secrets set EBAY_APP_ID=your-client-id
# supabase secrets set EBAY_CLIENT_SECRET=your-client-secret
# Get yours at https://developer.ebay.com/my/keys

# Anthropic — set as a Supabase Edge Function secret, NOT in .env
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
